{
  "manifest_version": 3,
  "name": "AWT 录制助手",
  "version": "0.5.0",
  "description": "AWT 自动化测试框架录制辅助插件 - 智能增强版 (支持定位器健检、DOM 探索与 Midscene 视觉探索)",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "webNavigation"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "ws://127.0.0.1/*",
    "ws://localhost/*",
    "<all_urls>"
  ],
  "action": {
    "default_title": "打开 AWT 录制侧边栏",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "options_page": "settings/settings.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "config/default_config.js",
        "adapters/base_adapter.js",
        "adapters/generic.js",
        "adapters/ant_design.js",
        "adapters/element_ui.js",
        "content/dom_utils.js",
        "content/highlight.js",
        "content/recorder.js",
        "content/health_checker.js",
        "content/explorer_agent.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
